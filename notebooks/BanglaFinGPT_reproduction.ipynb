   "source": [
    "## 5. Retrieval (Eq. 16)\n",
    "\n",
    "Hybrid scoring: `score = alpha * dense + (1 - alpha) * BM25`.\n",
    "\n",
    "The paper uses multilingual-E5 for the dense half. This run has no GPU and no\n",
    "`sentence-transformers`, so the dense half falls back to a hashed character/word\n",
    "n-gram embedder. That fallback is much weaker than E5 — the alpha sweep below shows\n",
    "exactly how much weaker, and is the reason the tuned alpha here leans on BM25."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "cell019",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-15T08:55:13.304765Z",
     "iopub.status.busy": "2026-09-15T08:55:13.304577Z",
     "iopub.status.idle": "2026-09-15T08:55:17.281059Z",
     "shell.execute_reply": "2026-09-15T08:55:17.280120Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "dense encoder: HashingEmbedder (dim=512)\n",
      "  note: sentence-transformers/torch unavailable -> hashed n-gram fallback in use\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "indexed 4858 chunks in 4.0s\n"
     ]
    }
   ],
   "source": [
    "from banglafingpt.retrieval.embedder import HashingEmbedder, load_embedder\n",
    "from banglafingpt.retrieval.retriever import HybridRetriever\n",
    "\n",
    "cfg = load_config(ROOT / \"configs\" / \"default.yaml\")\n",
    "cfg.retrieval.index_dir = str(ROOT / \"artifacts\" / \"index\")\n",
    "\n",
    "embedder = load_embedder(cfg.retrieval.embedding_model)   # falls back if torch is absent\n",
    "print(f\"dense encoder: {type(embedder).__name__} (dim={embedder.dim})\")\n",
    "if isinstance(embedder, HashingEmbedder):\n",
    "    print(\"  note: sentence-transformers/torch unavailable -> hashed n-gram fallback in use\")\n",
    "\n",
    "t0 = time.time()\n",
    "retriever = HybridRetriever.from_segments(segments, cfg.retrieval, embedder=embedder)\n",
    "print(f\"indexed {len(retriever.index)} chunks in {time.time() - t0:.1f}s\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell020",
   "metadata": {},
   "source": [
    "### 5.1 Tune the dense/sparse mix on the validation split\n",
    "\n",
    "Retrieval is scored at passage level: a hit means the passage the answer came from was\n",
    "returned, regardless of which of its chunks."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "cell021",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-15T08:55:17.283289Z",
     "iopub.status.busy": "2026-09-15T08:55:17.283106Z",
     "iopub.status.idle": "2026-09-15T08:55:21.212807Z",
     "shell.execute_reply": "2026-09-15T08:55:21.212362Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "       recall@1  recall@5  recall@10  mrr@10\n",
      "alpha                                       \n",
      "0.0       0.522     0.802      0.853   0.642\n",
      "0.2       0.532     0.797      0.853   0.648\n",
      "0.3       0.552     0.787      0.848   0.655\n",
      "0.5       0.487     0.750      0.815   0.599\n",
      "0.7       0.385     0.618      0.725   0.490\n",
      "1.0       0.315     0.527      0.593   0.408 \n",
      "\n",
      "selected alpha = 0.0 (alpha=1.0 is dense-only, 0.0 is BM25-only)\n"
     ]
    }
   ],
   "source": [
    "def recall_at_k(retriever, evaluation_pairs, ks=(1, 5, 10)):\n",
    "    # Passage-level recall@k and MRR@10.\n",
    "    max_k = max(ks)\n",
    "    hits = {k: 0 for k in ks}\n",
    "    reciprocal = 0.0\n",
    "    for pair in evaluation_pairs:\n",
    "        docs = [c.doc_id for c in retriever.retrieve(pair.question, top_k=max_k)]\n",
    "        for k in ks:\n",
    "            if pair.source in docs[:k]:\n",
    "                hits[k] += 1\n",
    "        if pair.source in docs:\n",
    "            reciprocal += 1 / (docs.index(pair.source) + 1)\n",
    "    n = len(evaluation_pairs)\n",
    "    out = {f\"recall@{k}\": round(hits[k] / n, 3) for k in ks}\n",
    "    out[\"mrr@10\"] = round(reciprocal / n, 3)\n",
    "    return out\n",
    "\n",
    "\n",
    "random.seed(SEED)\n",
    "tuning_pairs = random.sample(val_pairs, min(400, len(val_pairs)))\n",
    "\n",
    "sweep = []\n",
    "for alpha in [0.0, 0.2, 0.3, 0.5, 0.7, 1.0]:\n",
    "    retriever.config.hybrid_alpha = alpha\n",
    "    sweep.append({\"alpha\": alpha, **recall_at_k(retriever, tuning_pairs)})\n",
    "\n",
    "sweep_df = pd.DataFrame(sweep).set_index(\"alpha\")\n",
    "best_alpha = float(sweep_df[\"recall@5\"].idxmax())\n",
    "retriever.config.hybrid_alpha = best_alpha\n",
    "cfg.retrieval.hybrid_alpha = best_alpha\n",
    "print(sweep_df, f\"\\n\\nselected alpha = {best_alpha} (alpha=1.0 is dense-only, 0.0 is BM25-only)\")"
   ]
  },
